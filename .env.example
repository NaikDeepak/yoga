# Copy to .env (gitignored). See docs/environments.md for which block matters when.

# ── LOCAL DEV (default) ───────────────────────────────────────────────────────
# Mock mode: PGlite DB in .local-db/, mock login, files in public/uploads/.
# Sign in: dr.demo@example.com / password. The app refuses this in production.
LOCAL_MOCK=true

# ── PRODUCTION — used only by the npm run *:prod scripts ─────────────────────
# Neon → Connect → Pooled connection. Never commit; never paste into chats.
PROD_DATABASE_URL=
# Live site checked by `npm run deploy:prod` (defaults to https://yoga-ten-tau.vercel.app)
# PROD_SITE_URL=

# ── App settings (in Vercel → Settings → Environment Variables for production) ─
# Database the app uses. Production: the Neon pooled URL. Not needed in mock mode.
DATABASE_URL=

# Login only — Supabase Auth (project yabzxeetzihtnbumampg). Supabase holds no app data.
# Not needed in mock mode; needed for `npm run dev:prod-db`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Files — Cloudflare R2 (all four required outside mock mode)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=patient-files

# AI treatment drafts + posture analysis (Gemini). Mock mode returns canned output without it.
GEMINI_API_KEY=

# AI posture analysis (premium, in development): shown in local dev, hidden in production unless true.
FEATURE_POSTURE=

# Public address used in client share links (production: https://yoga-ten-tau.vercel.app)
APP_URL=
